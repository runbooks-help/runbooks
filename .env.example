# Personal/secret dev values, injected by mise via [env] _.file = ".env".
# Copy to .env (git-ignored) and fill in. Without it, git sync is disabled and
# the app runs with the committed defaults in mise.toml.
#
# Git sync (see https://runbooks.help/configuration and specs/runbooks/notes-git-sync).
# GITSYNC_REPO is the private notes repo.
GITSYNC_REPO=git@github.com:you/runbooks-sync-test.git
GITSYNC_AUTHOR_NAME="Runbooks Sync Bot"
GITSYNC_AUTHOR_EMAIL=you@example.com
GITSYNC_API_TOKEN=dev-local-bearer
#
# SSH remotes authenticate with the ambient SSH agent (ssh-agent, 1Password, …),
# so no key is needed locally. Uncomment only where there is no agent — a
# deployment or CI job — and point it at the mounted key:
# GITSYNC_SSH_KEY=/run/secrets/gitsync_key
