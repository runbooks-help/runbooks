package views

import "runbooks/parser"

templ RunbookPage(rb parser.RunbookDef, groups []parser.SystemGroup, cfg PageConfig) {
	@Shell(rb.Title) {
		@templ.Raw("<script id=\"runbook-source\" type=\"application/json\">" + jsonString(rb.Source) + "</script>")
		@templ.Raw("<script id=\"page-config\" type=\"application/json\">" + pageConfigJSON(cfg) + "</script>")
		@Rail()
		<aside class="sidebar">
			@SidebarHeader()
			@SidebarNav(groups, rb.Slug)
			@AppearanceControl()
			@SessionActions(cfg.IsAdmin, cfg.IdentityEnabled)
		</aside>
		<aside class="notes-panel">
			<div class="notes-resize" aria-hidden="true"></div>
			<div class="notes-header">
				<div class="notes-tabs">
					<button class="notes-tab active" data-mode="edit" type="button">Edit</button>
					<button class="notes-tab" data-mode="preview" type="button">Preview</button>
				</div>
				<label class="notes-record" title="Append completed steps to the notes as a timestamped timeline">
					<input class="notes-record-check" type="checkbox" checked/>
					Record timeline
				</label>
				<div class="notes-actions">
					<button class="notes-export" type="button" title="Download this record as a ZIP — no repo credential needed">Export</button>
					<button class="notes-print" type="button">Print</button>
					<button class="notes-clear" type="button">Clear</button>
					if cfg.GitSyncEnabled {
						<button class="notes-sync" type="button">Sync</button>
					}
				</div>
				<button class="drawer-close notes-close" type="button" data-drawer-close aria-label="Close">✕</button>
			</div>
			<textarea class="notes-textarea" spellcheck="false" placeholder="Markdown supported — paste screenshots too"></textarea>
			<div class="notes-preview" hidden></div>
			<div class="notes-sync-toast" hidden role="status">
				<span class="notes-sync-toast-msg"></span>
				<button class="notes-sync-toast-close" type="button" aria-label="Dismiss">✕</button>
			</div>
		</aside>
		<div class="main">
			if rb.Acknowledge != "" {
				<dialog
					class="dialog"
					id="ack-dialog"
					data-ack-dialog
					data-ack-slug={ rb.Slug }
					if cfg.IdentityEnabled {
						data-ack-endpoint="/api/runbooks/v1/ack"
					}
				>
					<div class="dialog-header">Acknowledge this runbook</div>
					<div class="dialog-body">
						<p>{ rb.Acknowledge }</p>
					</div>
					<div class="dialog-footer">
						<button class="btn btn-danger" type="button" data-ack-accept>I understand</button>
					</div>
				</dialog>
			}
			<div class="zen-bar">
				<span class="zen-title">{ rb.Title }</span>
				<span class="zen-count"></span>
				<span class="spacer"></span>
				<button type="button" data-zen-action="prev">← Previous</button>
				<button type="button" data-zen-action="next">Next →</button>
				<button type="button" data-zen-action="exit">Exit zen</button>
			</div>
			<div class="main-header">
				<button class="btn btn-ghost notes-toggle" type="button" data-notes-toggle aria-pressed="true">Hide notes</button>
				<div class="runbook-tags">
					<span class="badge">{ rb.GroupTitle }</span>
					if rb.CategoryTitle != "" {
						<span class="badge">{ rb.CategoryTitle }</span>
					}
					if rb.Acknowledge != "" {
						<span class="badge badge-warn" data-ack-badge hidden title="You acknowledged this runbook this session">acknowledged</span>
					}
				</div>
				<h1>{ rb.Title }</h1>
				<p>@templ.Raw(proseHTML(rb.Description))</p>
			</div>
			if rb.Notice != "" {
				@FrontmatterNotice(rb.Notice)
			}
			if len(rb.Vars) > 0 {
				@VarsPanel(rb.Vars)
			}
			<div
				class="content"
				data-runbook
				if rb.Acknowledge != "" {
					data-ack="pending"
					inert
				}
			>
				if len(rb.Steps) >= 3 {
					<nav class="toc" aria-label="Contents" hidden>
						<p class="toc-label">Contents</p>
						<ol class="toc-list">
							for i, step := range rb.Steps {
								<li>
									<a href={ "#" + slugify(step.Title) }>
										<span class="toc-num">{ numStr(i + 1) }</span>
										{ step.Title }
									</a>
								</li>
							}
							if len(rb.Rollback) > 0 {
								<li><a href="#rollback">Rollback</a></li>
							}
						</ol>
					</nav>
				}
				if len(rb.Steps) >= 2 {
					<div class="step-controls">
						if len(rb.Steps) >= 3 {
							<button class="contents-btn" type="button" aria-pressed="false" title="Show a contents list">Contents</button>
						}
						<span class="spacer"></span>
						<button type="button" data-steps-action="expand">Expand all</button>
						<button type="button" data-steps-action="collapse">Collapse all</button>
						<button type="button" data-zen-action="enter">Zen</button>
					</div>
				}
				<div class="steps">
					for i, step := range rb.Steps {
						@stepCard(i+1, step, false)
					}
					if len(rb.Rollback) > 0 {
						<div id="rollback">
							<p class="section-label">Rollback</p>
							for _, step := range rb.Rollback {
								@stepCard(0, step, true)
							}
						</div>
					}
				</div>
			</div>
		</div>
	}
}

templ stepCard(n int, step parser.Step, rollback bool) {
	if rollback {
		@RollbackStep(step.Title) {
			for _, block := range step.Blocks {
				@renderBlock(block)
			}
		}
	} else {
		@Step(n, step.Title, stepPreview(step)) {
			for _, block := range step.Blocks {
				@renderBlock(block)
			}
		}
	}
}

templ renderBlock(b parser.Block) {
	switch b.Kind {
	case parser.KindCode:
		@CodeBlock(b.Label, b.Body, b.Lang)
	case parser.KindNotice:
		@Notice(b.Variant, b.Message)
	case parser.KindBranch:
		@BranchBlock(b.Body)
	case parser.KindHeading:
		<h3 class="step-subheading">{ b.Text }</h3>
	case parser.KindList:
		@ListBlock(b.Items)
	case parser.KindTable:
		@TableBlock(b.Headers, b.Rows)
	default:
		<p>@templ.Raw(proseHTML(b.Text))</p>
	}
}
