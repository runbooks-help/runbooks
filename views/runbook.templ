package views

import (
	"encoding/json"
	"strconv"
	"strings"

	"runbooks/parser"
	"runbooks/views/components"
	"runbooks/views/markup"
)

templ RunbookPage(rb parser.RunbookDef, groups []parser.SystemGroup, cfg PageConfig) {
	@components.Shell(rb.Title) {
		@templ.Raw("<script id=\"runbook-source\" type=\"application/json\">" + jsonString(rb.Source) + "</script>")
		@templ.Raw("<script id=\"page-config\" type=\"application/json\">" + pageConfigJSON(cfg) + "</script>")
		@components.Rail()
		<aside class="sidebar">
			@components.SidebarHeader()
			@components.SidebarNav(groups, rb.Slug)
			<div class="sidebar-appearance">
				@components.AppearanceTrigger(true)
			</div>
			@components.SessionActions(cfg.IsAdmin, cfg.IdentityEnabled)
		</aside>
		@components.NotesPanel(cfg.GitSyncEnabled)
		<div class="main">
			if rb.Acknowledge != "" {
				<dialog
					class="dialog"
					id="ack-dialog"
					data-ack-dialog
					data-ack-slug={ rb.Slug }
					if cfg.IdentityEnabled {
						data-ack-endpoint="/api/runbooks/v1/ack"
					}
				>
					<div class="dialog-header">Acknowledge this runbook</div>
					<div class="dialog-body">
						<p>{ rb.Acknowledge }</p>
					</div>
					<div class="dialog-footer">
						<button class="btn btn-danger" type="button" data-ack-accept>I understand</button>
					</div>
				</dialog>
			}
			<div class="zen-bar">
				<span class="zen-title">{ rb.Title }</span>
				<span class="zen-count"></span>
				<span class="spacer"></span>
				<button type="button" data-zen-action="prev">← Previous</button>
				<button type="button" data-zen-action="next">Next →</button>
				<button type="button" data-zen-action="exit">Exit zen</button>
			</div>
			<div class="runbook-scroll">
				<div class="main-header">
					<div class="runbook-tags">
						<span class="badge">{ rb.GroupTitle }</span>
						if rb.CategoryTitle != "" {
							<span class="badge">{ rb.CategoryTitle }</span>
						}
						if rb.Acknowledge != "" {
							<span class="badge badge-warn" data-ack-badge hidden title="You acknowledged this runbook this session">acknowledged</span>
						}
					</div>
					<h1>{ rb.Title }</h1>
					<p>
						@templ.Raw(markup.Prose(rb.Description))
					</p>
				</div>
				if rb.Notice != "" {
					@components.FrontmatterNotice(rb.Notice)
				}
				<div class="runbook-bar">
					if len(rb.Vars) > 0 {
						@components.VarsPanel(rb.Vars)
					}
					<button class="btn btn-ghost notes-toggle" type="button" data-notes-toggle aria-pressed="true" aria-label="Hide notes">Notes <span class="notes-toggle-glyph" aria-hidden="true">▸</span></button>
				</div>
				<div
					class="content"
					data-runbook
					if rb.Acknowledge != "" {
						data-ack="pending"
						inert
					}
				>
					if len(rb.Steps) >= 3 {
						<nav class="toc" aria-label="Contents" hidden>
							<p class="toc-label">Contents</p>
							<ol class="toc-list">
								for i, step := range rb.Steps {
									<li>
										<a href={ "#" + markup.Slug(step.Title) }>
											<span class="toc-num">{ strconv.Itoa(i + 1) }</span>
											{ step.Title }
										</a>
									</li>
								}
								if len(rb.Rollback) > 0 {
									<li><a href="#rollback">Rollback</a></li>
								}
							</ol>
						</nav>
					}
					if len(rb.Steps) >= 2 {
						<div class="step-controls">
							if len(rb.Steps) >= 3 {
								<button class="contents-btn" type="button" aria-pressed="false" title="Show a contents list">Contents</button>
							}
							<span class="spacer"></span>
							<button type="button" data-steps-action="expand">Expand all</button>
							<button type="button" data-steps-action="collapse">Collapse all</button>
							<button type="button" data-zen-action="enter">Zen</button>
						</div>
					}
					<div class="steps">
						for i, step := range rb.Steps {
							@stepCard(i+1, step, false)
						}
						if len(rb.Rollback) > 0 {
							<div id="rollback">
								<p class="section-label">Rollback</p>
								for _, step := range rb.Rollback {
									@stepCard(0, step, true)
								}
							</div>
						}
					</div>
				</div>
			</div>
		</div>
	}
}

templ stepCard(n int, step parser.Step, rollback bool) {
	if rollback {
		@components.RollbackStep(step.Title) {
			for _, block := range step.Blocks {
				@renderBlock(block)
			}
		}
	} else {
		@components.Step(n, step.Title, stepPreview(step)) {
			for _, block := range step.Blocks {
				@renderBlock(block)
			}
		}
	}
}

templ renderBlock(b parser.Block) {
	switch b.Kind {
		case parser.KindCode:
			@components.CodeBlock(b.Label, b.Body, b.Lang)
		case parser.KindNotice:
			@components.Notice(b.Variant, b.Message)
		case parser.KindBranch:
			@components.BranchBlock(b.Body)
		case parser.KindHeading:
			<h3 class="step-subheading">{ b.Text }</h3>
		case parser.KindList:
			@components.ListBlock(b.Items)
		case parser.KindTable:
			@components.TableBlock(b.Headers, b.Rows)
		default:
			<p>
				@templ.Raw(markup.Prose(b.Text))
			</p>
	}
}

// jsonString JSON-encodes a string for safe inline embedding in HTML (e.g. inside <script> tags).
func jsonString(s string) string {
	b, _ := json.Marshal(s)
	return string(b)
}

// pageConfigJSON renders PageConfig as the JSON embedded in the page.
func pageConfigJSON(c PageConfig) string {
	b, _ := json.Marshal(map[string]any{
		"gitSyncRequiresToken": c.GitSyncRequiresToken,
		"recordsBasePath":      c.RecordsBasePath,
	})
	return string(b)
}

// stepPreview is the one-line summary shown in place of a step's body while the
// step is collapsed: the first prose or heading, else the first code label.
func stepPreview(step parser.Step) string {
	for _, b := range step.Blocks {
		switch b.Kind {
		case parser.KindProse, parser.KindHeading:
			if s := strings.TrimSpace(b.Text); s != "" {
				return s
			}
		case parser.KindCode:
			if b.Label != "" {
				return b.Label
			}
		}
	}
	return ""
}
