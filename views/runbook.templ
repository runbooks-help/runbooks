package views

import "runbooks/parser"

templ RunbookPage(rb parser.RunbookDef, groups []parser.SystemGroup, cfg PageConfig) {
	@Shell(rb.Title) {
		@templ.Raw("<script id=\"runbook-source\" type=\"application/json\">" + jsonString(rb.Source) + "</script>")
		@templ.Raw("<script id=\"page-config\" type=\"application/json\">" + pageConfigJSON(cfg) + "</script>")
		@Rail()
		<aside class="sidebar">
			@SidebarHeader()
			@SidebarNav(groups, rb.Slug)
			@AppearanceControl()
			@SessionActions(cfg.IsAdmin, cfg.IdentityEnabled)
		</aside>
		<aside class="notes-panel" data-mode="edit">
			<div class="notes-resize" aria-hidden="true"></div>
			<p class="notes-dismiss-hint" aria-hidden="true">Release to hide notes</p>
			<div class="notes-header">
				<div class="notes-row">
					<div class="notes-tabs">
						<button class="notes-tab active" data-mode="edit" type="button">Edit</button>
						<button class="notes-tab" data-mode="preview" type="button">Preview</button>
					</div>
					<div class="notes-row-end">
						<label class="notes-record" title="Append completed steps to the notes as a timestamped timeline">
							<input class="notes-record-check" type="checkbox" checked/>
							Record timeline
						</label>
						<div class="notes-overflow">
							<button class="notes-tool" type="button" data-notes-menu aria-haspopup="menu" aria-expanded="false" aria-label="More actions" title="More actions">
								@templ.Raw(lucideIcon("ellipsis"))
							</button>
							<div class="notes-menu" role="menu" hidden>
								<button class="notes-export" type="button" role="menuitem" title="Download this record as a ZIP — no repo credential needed">Export · ZIP</button>
								<button class="notes-print" type="button" role="menuitem">Print</button>
								<div class="notes-menu-sep"></div>
								<button class="notes-clear notes-menu-danger" type="button" role="menuitem">Clear…</button>
								if cfg.GitSyncEnabled {
									<div class="notes-menu-sep"></div>
									<button class="notes-sync" type="button" role="menuitem">Sync</button>
								}
							</div>
						</div>
						<button class="drawer-close notes-close" type="button" data-drawer-close aria-label="Close">✕</button>
					</div>
				</div>
				<div class="notes-row notes-row-compose">
					<div class="notes-compose">
						@notesTool("bold", "bold", "Bold")
						@notesTool("italic", "italic", "Italic")
						@notesTool("code", "code", "Inline code")
						@notesTool("link", "link", "Link")
						@notesTool("image", "image", "Add screenshot — or paste with Ctrl/⌘ V")
						<span class="notes-tool-sep" aria-hidden="true"></span>
						@notesTool("ul", "list", "Bulleted list")
						@notesTool("ol", "list-ordered", "Numbered list")
						@notesTool("heading", "heading", "Heading")
						@notesTool("quote", "quote", "Quote")
						<span class="notes-tool-sep" aria-hidden="true"></span>
						<button class="notes-tool notes-tool--help" type="button" data-notes-help aria-expanded="false" aria-label="Markdown help" title="Markdown help">
							@templ.Raw(lucideIcon("circle-help"))
						</button>
					</div>
				</div>
				<div class="notes-cheatsheet" data-notes-cheatsheet hidden>
					<p class="notes-cheatsheet-label">Markdown</p>
					<dl class="notes-cheatsheet-list">
						<dt>**bold**</dt><dd>strong emphasis</dd>
						<dt>*italic*</dt><dd>emphasis</dd>
						<dt>`code`</dt><dd>inline token</dd>
						<dt>[text](url)</dt><dd>link — opens in a new tab</dd>
						<dt>![alt](url)</dt><dd>image</dd>
						<dt>- item</dt><dd>bulleted list</dd>
						<dt>1. item</dt><dd>numbered list</dd>
						<dt>## heading</dt><dd>section heading</dd>
						<dt>&gt; note</dt><dd>quote</dd>
						<dt>``` fence ```</dt><dd>code block</dd>
						<dt>| a | b |</dt><dd>table</dd>
					</dl>
					<p class="notes-cheatsheet-tip">Paste a screenshot with Ctrl/⌘ V, or use the image button.</p>
				</div>
			</div>
			<textarea class="notes-textarea" spellcheck="false" placeholder="Markdown supported — paste a screenshot with Ctrl/⌘ V, or use the image button"></textarea>
			<div class="notes-preview" hidden></div>
			<div class="notes-sync-toast" hidden role="status">
				<span class="notes-sync-toast-msg"></span>
				<button class="notes-sync-toast-close" type="button" aria-label="Dismiss">✕</button>
			</div>
		</aside>
		<div class="main">
			if rb.Acknowledge != "" {
				<dialog
					class="dialog"
					id="ack-dialog"
					data-ack-dialog
					data-ack-slug={ rb.Slug }
					if cfg.IdentityEnabled {
						data-ack-endpoint="/api/runbooks/v1/ack"
					}
				>
					<div class="dialog-header">Acknowledge this runbook</div>
					<div class="dialog-body">
						<p>{ rb.Acknowledge }</p>
					</div>
					<div class="dialog-footer">
						<button class="btn btn-danger" type="button" data-ack-accept>I understand</button>
					</div>
				</dialog>
			}
			<div class="zen-bar">
				<span class="zen-title">{ rb.Title }</span>
				<span class="zen-count"></span>
				<span class="spacer"></span>
				<button type="button" data-zen-action="prev">← Previous</button>
				<button type="button" data-zen-action="next">Next →</button>
				<button type="button" data-zen-action="exit">Exit zen</button>
			</div>
			<div class="main-header">
				<button class="btn btn-ghost notes-toggle" type="button" data-notes-toggle aria-pressed="true" aria-label="Hide notes">Notes <span class="notes-toggle-glyph" aria-hidden="true">▸</span></button>
				<div class="runbook-tags">
					<span class="badge">{ rb.GroupTitle }</span>
					if rb.CategoryTitle != "" {
						<span class="badge">{ rb.CategoryTitle }</span>
					}
					if rb.Acknowledge != "" {
						<span class="badge badge-warn" data-ack-badge hidden title="You acknowledged this runbook this session">acknowledged</span>
					}
				</div>
				<h1>{ rb.Title }</h1>
				<p>@templ.Raw(proseHTML(rb.Description))</p>
			</div>
			if rb.Notice != "" {
				@FrontmatterNotice(rb.Notice)
			}
			if len(rb.Vars) > 0 {
				@VarsPanel(rb.Vars)
			}
			<div
				class="content"
				data-runbook
				if rb.Acknowledge != "" {
					data-ack="pending"
					inert
				}
			>
				if len(rb.Steps) >= 3 {
					<nav class="toc" aria-label="Contents" hidden>
						<p class="toc-label">Contents</p>
						<ol class="toc-list">
							for i, step := range rb.Steps {
								<li>
									<a href={ "#" + slugify(step.Title) }>
										<span class="toc-num">{ numStr(i + 1) }</span>
										{ step.Title }
									</a>
								</li>
							}
							if len(rb.Rollback) > 0 {
								<li><a href="#rollback">Rollback</a></li>
							}
						</ol>
					</nav>
				}
				if len(rb.Steps) >= 2 {
					<div class="step-controls">
						if len(rb.Steps) >= 3 {
							<button class="contents-btn" type="button" aria-pressed="false" title="Show a contents list">Contents</button>
						}
						<span class="spacer"></span>
						<button type="button" data-steps-action="expand">Expand all</button>
						<button type="button" data-steps-action="collapse">Collapse all</button>
						<button type="button" data-zen-action="enter">Zen</button>
					</div>
				}
				<div class="steps">
					for i, step := range rb.Steps {
						@stepCard(i+1, step, false)
					}
					if len(rb.Rollback) > 0 {
						<div id="rollback">
							<p class="section-label">Rollback</p>
							for _, step := range rb.Rollback {
								@stepCard(0, step, true)
							}
						</div>
					}
				</div>
			</div>
		</div>
	}
}

templ notesTool(key, icon, label string) {
	<button class="notes-tool" data-notes-tool={ key } type="button" title={ label } aria-label={ label }>
		@templ.Raw(lucideIcon(icon))
	</button>
}

templ stepCard(n int, step parser.Step, rollback bool) {
	if rollback {
		@RollbackStep(step.Title) {
			for _, block := range step.Blocks {
				@renderBlock(block)
			}
		}
	} else {
		@Step(n, step.Title, stepPreview(step)) {
			for _, block := range step.Blocks {
				@renderBlock(block)
			}
		}
	}
}

templ renderBlock(b parser.Block) {
	switch b.Kind {
	case parser.KindCode:
		@CodeBlock(b.Label, b.Body, b.Lang)
	case parser.KindNotice:
		@Notice(b.Variant, b.Message)
	case parser.KindBranch:
		@BranchBlock(b.Body)
	case parser.KindHeading:
		<h3 class="step-subheading">{ b.Text }</h3>
	case parser.KindList:
		@ListBlock(b.Items)
	case parser.KindTable:
		@TableBlock(b.Headers, b.Rows)
	default:
		<p>@templ.Raw(proseHTML(b.Text))</p>
	}
}
