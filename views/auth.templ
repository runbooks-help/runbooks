package views

// LoginPage is the passkey sign-in page.
templ LoginPage() {
	@Shell("Sign in") {
		<div class="auth-main">
			<div class="auth-card">
				<h1 class="auth-title">Sign in</h1>
				<p class="auth-lede">Use a passkey to open the runbooks.</p>
				<button class="btn btn-primary" type="button" data-auth="login">Sign in with a passkey</button>
				@liveAlert()
				<p class="auth-status" data-auth-status hidden></p>
			</div>
		</div>
	}
}

// SetupPage bootstraps the first admin with the bootstrap token.
templ SetupPage() {
	@Shell("Set up") {
		<div class="auth-main">
			<div class="auth-card">
				<h1 class="auth-title">Set up this instance</h1>
				<p class="auth-lede">
					Create the first admin. The bootstrap token is the value of
					<code>IDENTITY_BOOTSTRAP_TOKEN</code> (or the one printed once at first boot).
				</p>
				<form class="stack" data-auth="setup">
					<div class="form-field">
						<label class="form-label" for="setup-token">Bootstrap token</label>
						<input class="text-input" id="setup-token" type="password" name="token" autocomplete="off" required/>
					</div>
					<div class="form-field">
						<label class="form-label" for="setup-name">Display name</label>
						<input class="text-input" id="setup-name" type="text" name="display_name" autocomplete="name" required/>
					</div>
					<div class="form-field">
						<label class="form-label" for="setup-email">Email <span class="form-optional">optional</span></label>
						<input class="text-input" id="setup-email" type="email" name="email" autocomplete="email"/>
					</div>
					<button class="btn btn-primary" type="submit">Create passkey</button>
				</form>
				@liveAlert()
				<p class="auth-status" data-auth-status hidden></p>
			</div>
		</div>
	}
}

// InvitePage accepts a single-use enrolment invite. For a re-enrolment bound to
// an existing user there is no name to choose, so those fields are hidden.
templ InvitePage(token string, reenrol bool) {
	@Shell("Join") {
		<div class="auth-main">
			<div class="auth-card">
				<h1 class="auth-title">You've been invited</h1>
				<p class="auth-lede">Create a passkey to join this instance.</p>
				<form class="stack" data-auth="invite" data-invite-token={ token }>
					if !reenrol {
						<div class="form-field">
							<label class="form-label" for="invite-name">Display name</label>
							<input class="text-input" id="invite-name" type="text" name="display_name" autocomplete="name" required/>
						</div>
						<div class="form-field">
							<label class="form-label" for="invite-email">Email <span class="form-optional">optional</span></label>
							<input class="text-input" id="invite-email" type="email" name="email" autocomplete="email"/>
						</div>
					}
					<button class="btn btn-primary" type="submit">Create passkey</button>
				</form>
				@liveAlert()
				<p class="auth-status" data-auth-status hidden></p>
			</div>
		</div>
	}
}

// InviteInvalidPage is shown when an invite link is missing, already used or
// expired. The blocking condition is the page, so it carries the banner weight.
templ InviteInvalidPage() {
	@Shell("Invite") {
		<div class="auth-main">
			<div class="auth-card">
				@Alert("banner", "danger", "Invite not valid", "This invite has already been used or has expired. Ask an admin for a new link.")
				<p class="auth-lede">Enrolment is blocked until you have a fresh link.</p>
			</div>
		</div>
	}
}
