package views

// LoginPage is the passkey sign-in page.
templ LoginPage() {
	@Shell("Sign in") {
		<div class="auth-main">
			<div class="auth-card">
				<h1 class="auth-title">Sign in</h1>
				<p class="auth-lede">Use a passkey to open the runbooks.</p>
				<button class="auth-button" type="button" data-auth="login">Sign in with a passkey</button>
				<p class="auth-status" data-auth-status hidden></p>
			</div>
		</div>
	}
}

// SetupPage bootstraps the first admin with the bootstrap token.
templ SetupPage() {
	@Shell("Set up") {
		<div class="auth-main">
			<div class="auth-card">
				<h1 class="auth-title">Set up this instance</h1>
				<p class="auth-lede">
					Create the first admin. The bootstrap token is the value of
					<code>IDENTITY_BOOTSTRAP_TOKEN</code> (or the one printed once at first boot).
				</p>
				<form class="auth-form" data-auth="setup">
					<label class="auth-field">
						Bootstrap token
						<input type="password" name="token" autocomplete="off" required/>
					</label>
					<label class="auth-field">
						Display name
						<input type="text" name="display_name" autocomplete="name" required/>
					</label>
					<label class="auth-field">
						Email <span class="auth-optional">optional</span>
						<input type="email" name="email" autocomplete="email"/>
					</label>
					<button class="auth-button" type="submit">Create passkey</button>
				</form>
				<p class="auth-status" data-auth-status hidden></p>
			</div>
		</div>
	}
}
