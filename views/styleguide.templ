package views

import (
	"runbooks/parser"
	"runbooks/views/components"
)

// StyleGuidePage renders the design system inside the app shell, organised by
// atomicity — Foundations, Layout primitives, Atoms, Molecules, Patterns — from
// the real tokens and templ components, so it cannot drift. The sidebar carries
// the styleguide's own section navigation. Dev-gated; see styleguide.go and
// STYLEGUIDE_ENABLED. Machine-readable mirror: /styleguide/llms.
templ StyleGuidePage(isAdmin, identityEnabled bool) {
	@components.Shell("Styleguide") {
		@components.Rail()
		<aside class="sidebar">
			@components.SidebarHeader()
			@styleGuideNav()
			<div class="sidebar-appearance">
				@components.AppearanceTrigger(true)
			</div>
			@components.SessionActions(isAdmin, identityEnabled)
		</aside>
		<div class="main main--full">
			<div class="main-header">
				<h1>Styleguide</h1>
				<p>
					Foundations and components, rendered from the real tokens and templ components.
					Machine-readable mirror: <a href="/styleguide/llms">/styleguide/llms</a>.
				</p>
			</div>
			<div class="content">
				<div class="sg-inner">
					<h2 class="sg-heading">Foundations</h2>

					<section class="sg-section" id="colours">
						<h3>Colours <span class="sg-atom">foundation</span></h3>
						<p>Seeded from the mallard — roles, never raw colour. Each swatch reads the live token.</p>
						<div class="sg-grid">
							@sgSwatch("--accent", "brand fill")
							@sgSwatch("--accent-strong", "brand text / icon")
							@sgSwatch("--accent-lt", "brand tint")
							@sgSwatch("--link", "links · info")
							@sgSwatch("--success", "ok")
							@sgSwatch("--warn", "warn")
							@sgSwatch("--danger", "danger")
							@sgSwatch("--bg", "page")
							@sgSwatch("--surface", "raised")
							@sgSwatch("--surface-2", "raised 2")
							@sgSwatch("--nav-bg", "chrome")
							@sgSwatch("--border", "border")
						</div>
					</section>

					<section class="sg-section" id="typography">
						<h3>Typography <span class="sg-atom">foundation</span></h3>
						<p>Atkinson Hyperlegible Next for UI and prose; Atkinson Hyperlegible Mono for commands, tokens and identifiers. Code weight is a preference (<code>--mono-weight</code>).</p>
						<div class="sg-specimen">
							<div style="font-size: var(--text-2xl); font-weight: 700">Replication lag</div>
							<div style="font-size: var(--text-xl); font-weight: 600">Step heading</div>
							<div style="font-size: var(--text-sm)">Body copy at 15px with generous leading, for a runbook opened under duress.</div>
							<div style="font-size: var(--text-2xs); color: var(--muted)">Muted secondary · hints · captions</div>
							<div class="sg-mono" style="font-size: var(--text-2xs)">mysql -h db-2 -e "SHOW SLAVE STATUS\G"</div>
							<div class="sg-mono" style="font-size: var(--text-2xs); color: var(--link)">PROCESSLIST_ID · 0123456789 · Il1 O0 5S rn m</div>
						</div>
					</section>

					<section class="sg-section" id="language">
						<h3>Tone and language <span class="sg-atom">foundation</span></h3>
						<p>
							<b>British English</b> in prose, identifiers and user-facing copy —
							<code>colour</code>, <code>behaviour</code>, <code>licence</code>,
							<code>enrol</code>/<code>enrolment</code>, <code>labelled</code>. American spelling
							only where the language itself demands it (the CSS <code>color</code> keyword,
							the <code>center</code> value).
						</p>
						<p>
							Copy is read under duress: titles lead with the symptom, not the mechanism,
							and instructions are short and imperative. Keep real code and identifier names.
						</p>
					</section>

					<section class="sg-section" id="spacing">
						<h3>Spacing <span class="sg-atom">foundation</span></h3>
						<p>One scale for every gap and padding — never raw px.</p>
						<div class="sg-stack">
							for _, s := range []string{"--space-1", "--space-2", "--space-3", "--space-4", "--space-5", "--space-6", "--space-7"} {
								<div class="sg-row">
									<code>{ s }</code>
									<div class="sg-bar" style={ "width: var(" + s + ")" }></div>
								</div>
							}
						</div>
					</section>

					<section class="sg-section" id="radius">
						<h3>Radius <span class="sg-atom">foundation</span></h3>
						<div class="sg-row">
							for _, r := range []string{"--radius-sm", "--radius-md", "--radius-lg"} {
								<div class="sg-stack" style="align-items: center">
									<div class="sg-box" style={ "border-radius: var(" + r + ")" }></div>
									<code>{ r }</code>
								</div>
							}
						</div>
					</section>

					<section class="sg-section" id="shadows">
						<h3>Shadows <span class="sg-atom">foundation</span></h3>
						<div class="sg-row">
							for _, sh := range []string{"--shadow-sm", "--shadow-md", "--shadow-lg"} {
								<div class="sg-stack" style="align-items: center">
									<div class="sg-box" style={ "border-radius: var(--radius-md); box-shadow: var(" + sh + ")" }></div>
									<code>{ sh }</code>
								</div>
							}
						</div>
					</section>

					<section class="sg-section" id="motion">
						<h3>Motion <span class="sg-atom">foundation</span></h3>
						<p>Two durations and one easing curve, used for hover and state transitions only.</p>
						<div class="sg-specimen sg-mono" style="font-size: var(--text-xs)">
							<div>--duration-fast · 120ms</div>
							<div>--duration-base · 200ms</div>
							<div>--ease · cubic-bezier(0.2, 0.8, 0.2, 1)</div>
						</div>
					</section>

					<h2 class="sg-heading">Layout primitives</h2>

					<section class="sg-section" id="layouts">
						<h3>Primitives <span class="sg-atom">layout</span></h3>
						<p>
							Layout uses the primitives in <code>layouts.css</code> only — never bespoke flex/grid in a component.
							Each is shown below with real content.
						</p>
						<div class="sg-stack sg-primitives">
							<div class="sg-primitive">
								<div class="sg-primitive-head"><code>.stack</code><span>vertical column · gap defaults to space-4</span></div>
								<div class="stack" style="max-width: 340px">
									<div class="sg-tile">Confirm the lag</div>
									<div class="sg-tile">Stop the SQL thread</div>
									<div class="sg-tile">Restart replication</div>
								</div>
							</div>
							<div class="sg-primitive">
								<div class="sg-primitive-head"><code>.cluster</code><span>wrapping row · chips, badges, actions</span></div>
								<div class="cluster">
									<button class="btn btn-primary" type="button">Export</button>
									<button class="btn btn-ghost" type="button">Filter</button>
									<button class="btn btn-ghost" type="button">Refresh</button>
									<span class="badge badge-ok">Synced</span>
								</div>
							</div>
							<div class="sg-primitive">
								<div class="sg-primitive-head"><code>.row</code><span>no wrap · min-width:0 baked in, with .truncate</span></div>
								<div class="row" data-gap="md">
									<span class="badge badge-info">mysql</span>
									<span class="truncate">Replica lag on db-2.prod.internal — the SQL thread is blocked</span>
									<button class="btn btn-ghost" type="button" style="flex-shrink:0">Open</button>
								</div>
							</div>
							<div class="sg-primitive">
								<div class="sg-primitive-head"><code>.grid</code><span>data-cols="auto" · responsive cards</span></div>
								<div class="grid" data-cols="auto" style="--grid-min: 160px">
									<div class="sg-tile">Replication Lag</div>
									<div class="sg-tile">Disk Full</div>
									<div class="sg-tile">Slot Migration</div>
								</div>
							</div>
						</div>
					</section>

					<h2 class="sg-heading">Atoms</h2>

					<section class="sg-section" id="button">
						<h3>Button <span class="sg-atom">atom</span></h3>
						<p>One base class and three intents; a button is a button everywhere.</p>
						<div class="sg-row">
							<button class="btn btn-primary" type="button">Primary</button>
							<button class="btn btn-ghost" type="button">Ghost</button>
							<button class="btn btn-danger" type="button">Danger</button>
							<button class="btn btn-primary" type="button" disabled>Disabled</button>
						</div>
					</section>

					<section class="sg-section" id="badge">
						<h3>Badge <span class="sg-atom">atom</span></h3>
						<p>Status carries colour; the brand accent never does.</p>
						<div class="sg-row">
							<span class="badge badge-ok">Synced</span>
							<span class="badge badge-warn">Optional</span>
							<span class="badge badge-danger">Destructive</span>
							<span class="badge badge-info">Read-only</span>
						</div>
					</section>

					<section class="sg-section" id="field">
						<h3>Field <span class="sg-atom">atom</span></h3>
						<p>A label, a control and an optional hint. Text inputs and selects share one treatment (<code>.text-input</code> / <code>.select-input</code>); <code>.form-row</code> grows fields to fill the row.</p>
						<div class="sg-specimen">
							<div class="form-row">
								<div class="form-field">
									<label class="form-label" for="sg-name">Display name</label>
									<input class="text-input" id="sg-name" type="text" placeholder="e.g. Ben"/>
								</div>
								<div class="form-field">
									<label class="form-label" for="sg-role">Role</label>
									<select class="select-input" id="sg-role">
										<option>Member</option>
										<option>Admin</option>
									</select>
									<span class="form-hint">Admins may invite and revoke.</span>
								</div>
							</div>
						</div>
					</section>

					<section class="sg-section" id="dialog">
						<h3>Dialog <span class="sg-atom">atom</span></h3>
						<p>
							A native &lt;dialog&gt; modal — the browser supplies the backdrop, focus trap and Esc.
							Server-rendered dialogs open with <code>data-dialog-open="id"</code> and close with
							<code>data-dialog-close</code>; JS confirmations use the same component via <code>showDialog()</code>.
						</p>
						<div class="sg-row">
							<button class="btn btn-primary" type="button" data-dialog-open="sg-dialog">Open dialog</button>
							<button class="btn btn-danger" type="button" data-dialog-open="sg-dialog-danger">Open destructive</button>
							<button class="btn btn-danger" type="button" data-dialog-open="sg-ack">Open acknowledgement</button>
						</div>
						<dialog class="dialog" id="sg-dialog">
							<div class="dialog-header">Dialog title</div>
							<div class="dialog-body">
								<p>Body content. Padding and typography come from the dialog module.</p>
							</div>
							<div class="dialog-footer">
								<button class="btn btn-ghost" type="button" data-dialog-close>Cancel</button>
								<button class="btn btn-primary" type="button" data-dialog-close>Confirm</button>
							</div>
						</dialog>
						<dialog class="dialog" id="sg-dialog-danger">
							<div class="dialog-header">Clear everything?</div>
							<div class="dialog-body">
								<p>The destructive action is a danger button on the right.</p>
							</div>
							<div class="dialog-footer">
								<button class="btn btn-ghost" type="button" data-dialog-close>Cancel</button>
								<button class="btn btn-danger" type="button" data-dialog-close>Clear</button>
							</div>
						</dialog>
						<dialog class="dialog" id="sg-ack">
							<div class="dialog-header">Acknowledge this runbook</div>
							<div class="dialog-body">
								<p>A destructive runbook declares <code>acknowledge:</code>; this dialog states it and the steps stay inert until accepted. In the app it is not dismissable — only <em>I understand</em> or leaving the page.</p>
							</div>
							<div class="dialog-footer">
								<button class="btn btn-danger" type="button" data-dialog-close>I understand</button>
							</div>
						</dialog>
					</section>

					<section class="sg-section" id="notice">
						<h3>Notice <span class="sg-atom">atom</span></h3>
						<p>Info, warn and danger, plus the banner used for a destructive runbook.</p>
						<div class="sg-stack">
							@components.Notice("info", "Use the primary node for reads while the replica catches up.")
							@components.Notice("warn", "This step briefly stops writes — check the drain is complete first.")
							@components.Notice("danger", "READ EVERY STEP BEFORE DOING ANYTHING. This recovery drops and rebuilds the replica.")
							@components.FrontmatterNotice("A frontmatter `notice:` renders this banner above the steps.")
						</div>
					</section>

					<h2 class="sg-heading">Molecules</h2>

					<section class="sg-section" id="toc">
						<h3>Contents <span class="sg-atom">molecule</span></h3>
						<p>A runbook's step list at the top of the page — shown once a runbook has three or more steps. Each link jumps to that step's card.</p>
						<nav class="toc" aria-label="Contents">
							<p class="toc-label">Contents</p>
							<ol class="toc-list">
								<li><a href="#toc"><span class="toc-num">1</span>Confirm the lag</a></li>
								<li><a href="#toc"><span class="toc-num">2</span>Stop the SQL thread</a></li>
								<li><a href="#toc"><span class="toc-num">3</span>Restart replication</a></li>
								<li><a href="#rollback">Rollback</a></li>
							</ol>
						</nav>
					</section>

					<section class="sg-section" id="alert">
						<h3>Alert <span class="sg-atom">molecule</span></h3>
						<p>
							Interactive feedback. Intent (danger, warn, info, success) is independent of
							weight (inline, panel, banner): the intent sets the colour, the weight sets the
							frame. Panel is the default; inline is for field validation, banner for a
							blocking condition. A notice is a prose callout; an alert is state.
						</p>
						<div class="sg-stack">
							@components.Alert("panel", "danger", "Could not join", "Your browser cancelled or timed out the passkey request.")
							@components.Alert("panel", "warn", "Passkey created, email not set", "You can add an email later from the admin table.")
							@components.Alert("panel", "info", "Waiting for your passkey", "Approve the request in your browser or password manager.")
							@components.Alert("panel", "success", "Invite created", "Share the link; it can be used once and expires in 24 hours.")
							@components.Alert("inline", "danger", "", "Enter a valid email address, for example you@example.com.")
							@components.Alert("banner", "danger", "Invite not valid", "This invite has already been used or has expired. Ask an admin for a new link.")
						</div>
					</section>

					<section class="sg-section" id="code">
						<h3>Code block <span class="sg-atom">molecule</span></h3>
						<p>A language and an optional bracketed label; the label renders as an inline header on the block — an accent ▸, the label, and a per-block done checkbox. Code stays dark in both themes.</p>
						<div class="stack">
							@components.CodeBlock("Promote the replica", "export HOST=\"db-2.prod.internal\"\nmysql -h \"$HOST\" -e \"STOP SLAVE; RESET SLAVE ALL;\"", "bash")
							@components.CodeBlock("", "SELECT id, state FROM information_schema.processlist;", "sql")
						</div>
					</section>

					<section class="sg-section" id="step">
						<h3>Step <span class="sg-atom">molecule</span></h3>
						<p>A numbered card. The header toggles it open or closed; collapsed, it shows the preview line in place of the body.</p>
						<div class="steps">
							@components.Step(1, "Confirm the lag", "Check the replica's lag and last error.") {
								<p>Prose inside a step body. Notice the numbered header, the done checkbox and the collapse chevron.</p>
							}
							@components.Step(2, "Stop the SQL thread", "Stop the thread before you clear the deadlock.") {
								<p>The replica no longer applies transactions while you resolve the deadlock.</p>
								@components.Notice("warn", "Writes on the primary keep coming until the next step finishes.")
							}
							<div class="step-card collapsed">
								<div class="step-header">
									<span class="step-num">3</span>
									<h2 class="step-title">A collapsed step</h2>
									<button class="step-check" type="button" aria-label="Mark step done">✓</button>
									<button class="step-toggle" type="button" aria-expanded="false" aria-label="Toggle step">▾</button>
								</div>
								<div class="step-body">
									<p>Hidden while the step is collapsed.</p>
								</div>
								<p class="step-preview">The preview line shown in place of the body while collapsed.</p>
							</div>
							@components.RollbackStep("Roll back the promotion") {
								<p>Rollback steps render in the danger styling, without a number.</p>
							}
						</div>
					</section>

					<section class="sg-section" id="table">
						<h3>List &amp; table <span class="sg-atom">molecule</span></h3>
						@components.ListBlock([]string{"First item — plain text", "Second item with `inline code` and **bold**", "Third item, long enough to wrap onto a second line"})
						@components.TableBlock([]string{"Column", "Meaning", "Example"}, [][]string{
							{"`HOST`", "Target host", "`db-2.prod.internal`"},
							{"`PROCESSLIST_ID`", "Blocked worker", "`4123`"},
							{"Status", "Whether a step is done", "`done` / `pending`"},
						})
					</section>

					<section class="sg-section" id="card">
						<h3>Card <span class="sg-atom">molecule</span></h3>
						<div class="card-grid">
							<a class="runbook-card" href="#">
								<span class="card-title">Replication Lag (MTS Deadlock)</span>
								<span class="card-desc">Parallel worker deadlock stalls the replica SQL thread.</span>
							</a>
							<a class="runbook-card" href="#">
								<span class="card-title">Disk Full (inode exhaustion)</span>
								<span class="card-desc">No space left on device, but df shows free bytes.</span>
							</a>
						</div>
					</section>

					<h2 class="sg-heading">Patterns</h2>

					<section class="sg-section" id="sidebar-nav">
						<h3>Sidebar navigation <span class="sg-atom">pattern</span></h3>
						<p>
							The runbook tree: a filter field over collapsible systems and categories.
							The branch owning the active runbook is open on load; a query overrides
							collapse and counts the matches. Shown in a sidebar-width frame.
						</p>
						<div class="sg-sidebar">
							@components.SidebarNav(sgSidebarGroups(), "replication-lag-bulk-import")
						</div>
					</section>

					<section class="sg-section" id="appearance">
						<h3>Appearance <span class="sg-atom">pattern</span></h3>
						<p>Theme, code weight, text size and steps, applied before first paint and persisted in <code>runbooks-*</code>. One floating panel, summoned from a cogwheel in the rail (always visible) or the strip at the foot of the summoned sidebar; the anchor position beside the summoner is drawer state, not component CSS. Shown here open, as it appears in the app.</p>
						<div class="sg-sidebar">
							@components.AppearanceTrigger(true)
						</div>
						<div class="appearance">
							<p class="appearance-title">Appearance</p>
							<div>
								<p class="appearance-label">Theme</p>
								<div class="theme-row">
									<button class="theme-btn" data-theme="light" type="button">Light</button>
									<button class="theme-btn" data-theme="system" type="button">System</button>
									<button class="theme-btn active" data-theme="dark" type="button">Dark</button>
								</div>
							</div>
							<div>
								<p class="appearance-label">Code weight</p>
								<div class="weight-row">
									<button class="weight-btn" data-weight="regular" type="button">Regular</button>
									<button class="weight-btn" data-weight="bold" type="button">Bold</button>
								</div>
							</div>
							<div>
								<p class="appearance-label">Text size</p>
								<div class="size-row">
									<button class="size-btn" data-size="small" type="button" title="Small">S</button>
									<button class="size-btn" data-size="medium" type="button" title="Medium">M</button>
									<button class="size-btn" data-size="large" type="button" title="Large">L</button>
								</div>
							</div>
							<div>
								<p class="appearance-label">Steps</p>
								<div class="steps-row">
									<button class="steps-btn" data-steps="first" type="button" title="Open the first step, collapse the rest">First open</button>
									<button class="steps-btn" data-steps="all" type="button" title="Open every step">All open</button>
								</div>
							</div>
						</div>
					</section>

					<section class="sg-section" id="session">
						<h3>Session actions <span class="sg-atom">pattern</span></h3>
						<p>The sidebar footer account row: the Admin link (admins) and Sign out (identity on).</p>
						<div class="sg-sidebar">
							@components.SessionActions(true, true)
						</div>
					</section>

					<section class="sg-section" id="admin">
						<h3>Admin invite form <span class="sg-atom">pattern</span></h3>
						<p>Role and expiry selects with a primary action — the form used on <code>/admin</code>.</p>
						<section class="admin-card">
							<form class="form-row" data-admin="invite">
								<div class="form-field">
									<label class="form-label" for="sg-invite-role">Role</label>
									<select class="select-input" id="sg-invite-role" name="role">
										<option value="member">Member</option>
										<option value="admin">Admin</option>
									</select>
								</div>
								<div class="form-field">
									<label class="form-label" for="sg-invite-ttl">Expires</label>
									<select class="select-input" id="sg-invite-ttl" name="ttl">
										<option value="24h">1 day</option>
										<option value="72h" selected>3 days</option>
									</select>
								</div>
								<button class="btn btn-primary" type="submit">Create invite link</button>
							</form>
						</section>
					</section>
				</div>
			</div>
		</div>
	}
}

// styleGuideNav is the styleguide's own sidebar navigation, grouped by atomicity.
templ styleGuideNav() {
	<p class="nav-system">Styleguide</p>
	<p class="nav-section">Foundations</p>
	<nav>
		<a href="#colours">Colours</a>
		<a href="#typography">Typography</a>
		<a href="#language">Language</a>
		<a href="#spacing">Spacing</a>
		<a href="#radius">Radius</a>
		<a href="#shadows">Shadows</a>
		<a href="#motion">Motion</a>
	</nav>
	<p class="nav-section">Layout</p>
	<nav>
		<a href="#layouts">Primitives</a>
	</nav>
	<p class="nav-section">Atoms</p>
	<nav>
		<a href="#button">Button</a>
		<a href="#badge">Badge</a>
		<a href="#field">Field</a>
		<a href="#dialog">Dialog</a>
		<a href="#notice">Notice</a>
	</nav>
	<p class="nav-section">Molecules</p>
	<nav>
		<a href="#toc">Contents</a>
		<a href="#alert">Alert</a>
		<a href="#code">Code</a>
		<a href="#step">Step</a>
		<a href="#table">Table</a>
		<a href="#card">Card</a>
	</nav>
	<p class="nav-section">Patterns</p>
	<nav>
		<a href="#sidebar-nav">Sidebar navigation</a>
		<a href="#appearance">Appearance</a>
		<a href="#session">Session actions</a>
		<a href="#admin">Admin form</a>
	</nav>
}

templ sgSwatch(token, label string) {
	<div class="sg-swatch">
		<div class="chip" style={ "background: var(" + token + ")" }></div>
		<div class="meta"><code>{ token }</code> · { label }</div>
	</div>
}

// sgSidebarGroups is the sample tree the styleguide renders the sidebar-nav
// pattern from — it must not depend on the content tree, which is empty in a
// fresh checkout. The values are invented, not drawn from real content.
func sgSidebarGroups() []parser.SystemGroup {
	return []parser.SystemGroup{
		{
			Name: "MySQL",
			Categories: []parser.CategoryGroup{
				{
					Name: "Replication",
					Runbooks: []parser.RunbookMeta{
						{
							Title:       "Replication Lag After a Bulk Import",
							Slug:        "replication-lag-bulk-import",
							Description: "Replica workers fall behind while the primary finishes a large load.",
							Symptoms:    []string{"replication lag", "replica behind"},
						},
						{Title: "Replica Stops With a Duplicate Key", Slug: "replica-duplicate-key"},
						{Title: "Rebuild a Replica From a Snapshot", Slug: "rebuild-replica-snapshot"},
					},
				},
				{
					Name:     "Failover",
					Runbooks: []parser.RunbookMeta{{Title: "Promote a Replica During an Outage", Slug: "promote-replica-outage"}},
				},
			},
		},
		{
			Name: "Kubernetes",
			Categories: []parser.CategoryGroup{
				{
					Name:     "Cluster",
					Runbooks: []parser.RunbookMeta{{Title: "Node NotReady After a Reboot", Slug: "node-notready-after-reboot"}},
				},
			},
		},
	}
}
