package views

import (
	"runbooks/parser"
	"runbooks/stores"
	"runbooks/views/components"
)

// AdminPage manages people — inside the app shell, so it reads as part of the
// runbooks application rather than a standalone card.
templ AdminPage(groups []parser.SystemGroup, users []stores.User, isAdmin, identityEnabled bool) {
	@components.Shell("Admin") {
		@components.Rail()
		<aside class="sidebar">
			@components.SidebarHeader()
			@components.SidebarNav(groups, "admin")
			<div class="sidebar-appearance">
				@components.AppearanceTrigger(true)
			</div>
			@components.SessionActions(isAdmin, identityEnabled)
		</aside>
		<div class="main main--full">
			<div class="main-header">
				<h1>Admin</h1>
				<p>Invite people, re-enrol a passkey, or end sessions. <a href="/admin/audit">Audit log</a></p>
			</div>
			<div class="content">
				<div class="stack admin-inner">
					<div class="admin-result" hidden data-admin-result>
						<input class="admin-url" type="text" readonly data-admin-url aria-label="Invite link"/>
						<button class="btn btn-ghost" type="button" data-admin-copy>Copy</button>
					</div>
					@components.LiveAlert()
					<p class="auth-status" data-admin-status hidden></p>

					<section class="admin-card">
						<p class="section-label">Invite someone</p>
						<form class="form-row" data-admin="invite">
							<div class="form-field">
								<label class="form-label" for="invite-role">Role</label>
								<select class="select-input" id="invite-role" name="role">
									<option value="member">Member</option>
									<option value="admin">Admin</option>
								</select>
							</div>
							<div class="form-field">
								<label class="form-label" for="invite-ttl">Expires</label>
								<select class="select-input" id="invite-ttl" name="ttl">
									<option value="1h">1 hour</option>
									<option value="24h">1 day</option>
									<option value="72h" selected>3 days</option>
									<option value="168h">7 days</option>
								</select>
							</div>
							<button class="btn btn-primary" type="submit">Create invite link</button>
						</form>
					</section>

					<section class="admin-card">
						<p class="section-label">Users</p>
						<div class="table-wrap">
							<table class="admin-table">
								<thead>
									<tr>
										<th>Name</th>
										<th>Email</th>
										<th>Role</th>
										<th>Status</th>
										<th></th>
									</tr>
								</thead>
								<tbody>
									for _, u := range users {
										<tr>
											<td>{ u.DisplayName }</td>
											<td>{ u.Email }</td>
											<td>
												if u.IsAdmin() {
													<span class="badge badge-info">admin</span>
												} else {
													<span class="badge">member</span>
												}
											</td>
											<td>
												if u.Enabled() {
													<span class="badge badge-ok">active</span>
												} else {
													<span class="badge badge-danger">disabled</span>
												}
											</td>
											<td class="admin-actions">
												<button class="btn btn-ghost" type="button" data-admin="reenrol" data-user-id={ u.ID }>
													New passkey link
												</button>
												<button class="btn btn-danger" type="button" data-admin="revoke" data-user-id={ u.ID }>
													Revoke sessions
												</button>
												if u.Enabled() {
													<button class="btn btn-danger" type="button" data-admin="disable" data-user-id={ u.ID }>Disable</button>
												} else {
													<button class="btn btn-ghost" type="button" data-admin="enable" data-user-id={ u.ID }>Enable</button>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					</section>
				</div>
			</div>
		</div>
	}
}
