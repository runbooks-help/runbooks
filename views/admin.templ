package views

import "runbooks/stores"

// AdminPage manages people: mint invite links and end sessions. Admin-only —
// the route is gated in main.go.
templ AdminPage(users []stores.User) {
	@Shell("Admin") {
		<div class="admin-main">
			<header class="admin-header">
				<a class="admin-home" href="/">← Runbooks</a>
				<h1 class="auth-title">Admin</h1>
				<p class="auth-lede">Invite people, re-enrol a passkey, or end sessions.</p>
			</header>

			<div class="admin-result" hidden data-admin-result>
				<input class="admin-url" type="text" readonly data-admin-url aria-label="Invite link"/>
				<button class="admin-action" type="button" data-admin-copy>Copy</button>
			</div>
			<p class="auth-status" data-admin-status hidden></p>

			<section class="admin-card">
				<p class="section-label">Invite someone</p>
				<form class="auth-form admin-form" data-admin="invite">
					<label class="auth-field">
						Role
						<select name="role">
							<option value="member">Member</option>
							<option value="admin">Admin</option>
						</select>
					</label>
					<label class="auth-field">
						Expires
						<select name="ttl">
							<option value="1h">1 hour</option>
							<option value="24h">1 day</option>
							<option value="72h" selected>3 days</option>
							<option value="168h">7 days</option>
						</select>
					</label>
					<button class="auth-button" type="submit">Create invite link</button>
				</form>
			</section>

			<section class="admin-card">
				<p class="section-label">Users</p>
				<div class="table-wrap">
					<table class="admin-table">
						<thead>
							<tr>
								<th>Name</th>
								<th>Email</th>
								<th>Role</th>
								<th>Status</th>
								<th></th>
							</tr>
						</thead>
						<tbody>
							for _, u := range users {
								<tr>
									<td>{ u.DisplayName }</td>
									<td>{ u.Email }</td>
									<td>{ string(u.Role) }</td>
									<td>
										if u.Enabled() {
											Active
										} else {
											Disabled
										}
									</td>
									<td class="admin-actions">
										<button class="admin-action" type="button" data-admin="reenrol" data-user-id={ u.ID }>
											New passkey link
										</button>
										<button class="admin-action" type="button" data-admin="revoke" data-user-id={ u.ID }>
											Revoke sessions
										</button>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>
		</div>
	}
}
