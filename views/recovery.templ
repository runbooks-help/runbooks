package views

import "runbooks/views/components"

// RecoveryPage re-enrols a passkey for the instance's sole admin using the
// break-glass recovery token.
templ RecoveryPage() {
	@components.Shell("Recover") {
		<div class="auth-main">
			<div class="auth-card">
				<h1 class="auth-title">Recover access</h1>
				<p class="auth-lede">
					Add a passkey for the instance's only admin. The recovery token is the value of
					<code>IDENTITY_RECOVERY_TOKEN</code>.
				</p>
				<form class="stack" data-auth="recovery">
					<div class="form-field">
						<label class="form-label" for="recovery-token">Recovery token</label>
						<input class="text-input" id="recovery-token" type="password" name="token" autocomplete="off" required/>
					</div>
					<button class="btn btn-primary" type="submit">Add a passkey</button>
				</form>
				@components.LiveAlert()
				<p class="auth-status" data-auth-status hidden></p>
			</div>
		</div>
	}
}
