package views

// RecoveryPage re-enrols a passkey for the instance's sole admin using the
// break-glass recovery token.
templ RecoveryPage() {
	@Shell("Recover") {
		<div class="auth-main">
			<div class="auth-card">
				<h1 class="auth-title">Recover access</h1>
				<p class="auth-lede">
					Add a passkey for the instance's only admin. The recovery token is the value of
					<code>IDENTITY_RECOVERY_TOKEN</code>.
				</p>
				<form class="auth-form" data-auth="recovery">
					<label class="auth-field">
						Recovery token
						<input type="password" name="token" autocomplete="off" required/>
					</label>
					<button class="auth-button" type="submit">Add a passkey</button>
				</form>
				@liveAlert()
				<p class="auth-status" data-auth-status hidden></p>
			</div>
		</div>
	}
}
