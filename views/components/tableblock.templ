package components

import "runbooks/views/markup"

templ TableBlock(headers []string, rows [][]string) {
	<div class="table-wrap">
		<table>
			<thead>
				<tr>
					for _, h := range headers {
						<th>@templ.Raw(markup.Prose(h))</th>
					}
				</tr>
			</thead>
			<tbody>
				for _, row := range rows {
					<tr>
						for _, cell := range row {
							<td>@templ.Raw(markup.Prose(cell))</td>
						}
					</tr>
				}
			</tbody>
		</table>
	</div>
}
