package components

import "runbooks/views/markup"

templ TableBlock(headers []string, rows [][]string, terms []string) {
	<div class="table-wrap">
		<table>
			<thead>
				<tr>
					for _, h := range headers {
						<th>@templ.Raw(markup.ProseGlossary(h, terms))</th>
					}
				</tr>
			</thead>
			<tbody>
				for _, row := range rows {
					<tr>
						for _, cell := range row {
							<td>@templ.Raw(markup.ProseGlossary(cell, terms))</td>
						}
					</tr>
				}
			</tbody>
		</table>
	</div>
}
