package components

import "runbooks/views/markup"

// DocSection renders an unnumbered, always-expanded documentation section: an
// anchored heading with its body. Used when a page is in doc mode (frontmatter
// layout: doc, or a ---docs region), as opposed to a numbered runbook step.
templ DocSection(title string) {
	<section class="doc-section" id={ markup.Slug(title) }>
		<h2 class="doc-title">{ title }</h2>
		<div class="doc-body">
			{ children... }
		</div>
	</section>
}
