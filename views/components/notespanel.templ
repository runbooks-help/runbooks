package components

import "runbooks/views/icons"

// NotesPanel is the runbook page's right-hand notes column: the compose toolbar,
// the markdown cheatsheet, the textarea/preview and the sync toast. gitSyncEnabled
// controls whether the overflow menu offers Sync (the server only enables it when
// git sync is configured).
templ NotesPanel(gitSyncEnabled bool) {
	<aside class="notes-panel" data-mode="edit">
		<div class="notes-resize" aria-hidden="true"></div>
		<p class="notes-dismiss-hint" aria-hidden="true">Release to hide notes</p>
		<div class="notes-header">
			<div class="notes-row">
				<div class="notes-tabs">
					<button class="notes-tab active" data-mode="edit" type="button">Edit</button>
					<button class="notes-tab" data-mode="preview" type="button">Preview</button>
				</div>
				<div class="notes-row-end">
					<label class="notes-record" title="Append completed steps to the notes as a timestamped timeline">
						<input class="notes-record-check" type="checkbox" checked/>
						Record timeline
					</label>
					<div class="notes-overflow">
						<button class="notes-tool" type="button" data-notes-menu aria-haspopup="menu" aria-expanded="false" aria-label="More actions" title="More actions">
							@templ.Raw(icons.Lucide("ellipsis"))
						</button>
						<div class="notes-menu" role="menu" hidden>
							<button class="notes-export" type="button" role="menuitem" title="Download this record as a ZIP, no repo credential needed">Export · ZIP</button>
							<button class="notes-print" type="button" role="menuitem">Print</button>
							<div class="notes-menu-sep"></div>
							<button class="notes-clear notes-menu-danger" type="button" role="menuitem">Clear…</button>
							if gitSyncEnabled {
								<div class="notes-menu-sep"></div>
								<button class="notes-sync" type="button" role="menuitem">Sync</button>
							}
						</div>
					</div>
					<button class="drawer-close notes-close" type="button" data-drawer-close aria-label="Close">✕</button>
				</div>
			</div>
			<div class="notes-row notes-row-compose">
				<div class="notes-compose">
					@notesTool("bold", "bold", "Bold")
					@notesTool("italic", "italic", "Italic")
					@notesTool("code", "code", "Inline code")
					@notesTool("link", "link", "Link")
					@notesTool("image", "image", "Add screenshot, or paste with Ctrl/⌘ V")
					<span class="notes-tool-sep" aria-hidden="true"></span>
					@notesTool("ul", "list", "Bulleted list")
					@notesTool("ol", "list-ordered", "Numbered list")
					@notesTool("heading", "heading", "Heading")
					@notesTool("quote", "quote", "Quote")
					<span class="notes-tool-sep" aria-hidden="true"></span>
					<button class="notes-tool notes-tool--help" type="button" data-notes-help aria-expanded="false" aria-label="Markdown help" title="Markdown help">
						@templ.Raw(icons.Lucide("circle-help"))
					</button>
				</div>
			</div>
			<div class="notes-cheatsheet" data-notes-cheatsheet hidden>
				<p class="notes-cheatsheet-label">Markdown</p>
				<dl class="notes-cheatsheet-list">
					<dt>**bold**</dt><dd>strong emphasis</dd>
					<dt>*italic*</dt><dd>emphasis</dd>
					<dt>`code`</dt><dd>inline token</dd>
					<dt>[text](url)</dt><dd>link, opens in a new tab</dd>
					<dt>![alt](url)</dt><dd>image</dd>
					<dt>- item</dt><dd>bulleted list</dd>
					<dt>1. item</dt><dd>numbered list</dd>
					<dt>## heading</dt><dd>section heading</dd>
					<dt>&gt; note</dt><dd>quote</dd>
					<dt>``` fence ```</dt><dd>code block</dd>
					<dt>| a | b |</dt><dd>table</dd>
				</dl>
				<p class="notes-cheatsheet-tip">Paste a screenshot with Ctrl/⌘ V, or use the image button.</p>
			</div>
		</div>
		<textarea class="notes-textarea" spellcheck="false" placeholder="Markdown supported, paste a screenshot with Ctrl/⌘ V, or use the image button"></textarea>
		<div class="notes-preview" hidden></div>
		<div class="notes-sync-toast" hidden role="status">
			<span class="notes-sync-toast-msg"></span>
			<button class="notes-sync-toast-close" type="button" aria-label="Dismiss">✕</button>
		</div>
	</aside>
}
