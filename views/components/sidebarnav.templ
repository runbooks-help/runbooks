package components

import (
	"strconv"

	"runbooks/parser"
)

// SidebarNav renders the runbook tree: a filter field over collapsible systems
// and categories. The branch owning the active runbook is open on load; a filter
// query overrides collapse. `active` is the current runbook slug ("" on the
// index). The whole tree is rendered and collapse is a class, so the filter can
// reach every runbook; the styleguide keeps the flat .nav-system/.nav-section nav.
templ SidebarNav(groups []parser.SystemGroup, active string) {
	if len(groups) > 0 {
		{{ sysActive, catActive := navActive(groups, active) }}
		<div class="nav-filter">
			<input
				class="nav-filter-input"
				type="search"
				placeholder="Filter runbooks…"
				aria-label="Filter runbooks"
				autocomplete="off"
				spellcheck="false"
			/>
			<span class="nav-filter-key" data-nav-filter-key aria-hidden="true">/</span>
			<button class="nav-filter-key nav-filter-clear" type="button" data-nav-filter-clear hidden aria-label="Clear filter">✕</button>
		</div>
		<p class="nav-results" data-nav-results hidden></p>
		<div class="nav-tree" data-nav-tree>
			for i, system := range groups {
				<section class={ navOpenClass("nav-sys", system.Name == sysActive) } data-nav-sys>
					<button
						class="nav-row"
						type="button"
						aria-expanded={ strconv.FormatBool(system.Name == sysActive) }
						aria-controls={ "nav-sys-" + strconv.Itoa(i) }
						data-nav-toggle
					>
						<span class="nav-chev" aria-hidden="true">▸</span>
						<span class="nav-sys-name">{ system.Name }</span>
						<span class="nav-count" data-nav-count data-total={ strconv.Itoa(systemRunbookCount(system)) }>
							{ strconv.Itoa(systemRunbookCount(system)) }
						</span>
					</button>
					<div class="nav-sys-body" id={ "nav-sys-" + strconv.Itoa(i) }>
						for j, group := range system.Categories {
							if group.Name == "" {
								@navLinks(group.Runbooks, active, system.Name, group.Name)
							} else {
								<section class={ navOpenClass("nav-cat", group.Name == catActive) } data-nav-cat>
									<button
										class="nav-row"
										type="button"
										aria-expanded={ strconv.FormatBool(group.Name == catActive) }
										aria-controls={ "nav-cat-" + strconv.Itoa(i) + "-" + strconv.Itoa(j) }
										data-nav-toggle
									>
										<span class="nav-chev" aria-hidden="true">▸</span>
										<span class="nav-cat-name">{ group.Name }</span>
										<span class="nav-count" data-nav-count data-total={ strconv.Itoa(len(group.Runbooks)) }>
											{ strconv.Itoa(len(group.Runbooks)) }
										</span>
									</button>
									<div class="nav-cat-body" id={ "nav-cat-" + strconv.Itoa(i) + "-" + strconv.Itoa(j) }>
										@navLinks(group.Runbooks, active, system.Name, group.Name)
									</div>
								</section>
							}
						}
					</div>
				</section>
			}
		</div>
	}
}

// navActive locates the active runbook's system and category so the sidebar can
// open exactly that branch on load. Both are empty when no branch owns the slug
// (the index page, or an unknown slug).
func navActive(groups []parser.SystemGroup, slug string) (system, category string) {
	if slug == "" {
		return "", ""
	}
	for _, s := range groups {
		for _, c := range s.Categories {
			for _, rb := range c.Runbooks {
				if rb.Slug == slug {
					return s.Name, c.Name
				}
			}
		}
	}
	return "", ""
}

// navOpenClass appends the open-state marker the sidebar tree toggles.
func navOpenClass(base string, open bool) string {
	if open {
		return base + " open"
	}
	return base
}

// systemRunbookCount is a system's total runbook count for the sidebar badge.
func systemRunbookCount(system parser.SystemGroup) int {
	n := 0
	for _, c := range system.Categories {
		n += len(c.Runbooks)
	}
	return n
}
