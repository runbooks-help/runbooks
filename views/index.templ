package views

import (
	"runbooks/parser"
	"runbooks/views/components"
	"runbooks/views/icons"
	"runbooks/views/markup"
)

// IndexPage is the welcome / navigation page: a filter box, the symptom-first
// shortcuts declared in runbook frontmatter, then the full catalogue as cards.
templ IndexPage(systems []parser.SystemGroup, cfg PageConfig) {
	@components.ShellMeta(components.Meta{Description: cfg.SiteDescription, Canonical: canonical(cfg.PublicURL, ""), Type: "website"}) {
		@components.Rail()
		<aside class="sidebar">
			@components.SidebarHeader()
			@components.SidebarNav(systems, "")
			<div class="sidebar-appearance">
				@components.AppearanceTrigger(true)
			</div>
			@components.SessionActions(cfg.IsAdmin, cfg.IdentityEnabled)
		</aside>
		<div class="main index-main">
			<div class="main-header">
				<h1>Runbooks</h1>
				if len(systems) == 0 {
					<p>Once you add content, it will show here.</p>
				} else {
					<p>Start from the symptom. Type to filter, or jump to a common issue.</p>
				}
			</div>
			<div class="content">
				<div class="index-inner">
					if len(systems) == 0 {
						<div class="index-welcome">
							<p class="index-welcome-title">No runbooks yet</p>
							<p>
								Add a Markdown file under
								<code>{ "content/<system>/<category>/<file>.md" }</code>
								and it will appear here. Its URL and heading come from the file's
								frontmatter (<code>slug</code> and <code>title</code>).
							</p>
						</div>
					} else {
						<section class="search-hub">
							<h2 class="search-hub-title">What's wrong?</h2>
							<p class="search-hub-sub">Describe the symptom and we'll find the runbook.</p>
							<div class="search-field">
								<span class="search-icon">
									@templ.Raw(icons.Lucide("search"))
								</span>
								<input
									class="index-search"
									type="search"
									placeholder="e.g. replication lag, primary down, 502 from kubectl logs"
									aria-label="Filter runbooks"
									autocomplete="off"
									spellcheck="false"
									autofocus
								/>
								<span class="search-key" data-search-key aria-hidden="true">/</span>
								<button
									class="search-key search-clear"
									type="button"
									data-search-clear
									aria-label="Clear search"
									hidden
								>✕</button>
							</div>
							@commonSymptoms(parser.CommonIssues(systems))
						</section>
						@components.Bookshelf(systems)
						<div class="index-results" data-search-results hidden aria-live="polite"></div>
						<div class="index-catalogue" data-search-catalogue>
							<p class="section-label index-catalogue-label">All runbooks</p>
							for _, system := range systems {
								<div class="index-group">
									<h2 class="index-system">{ system.Name }</h2>
									for _, group := range system.Categories {
										<div class="index-category">
											if group.Name != "" {
												<p class="index-category-label">{ group.Name }</p>
											}
											<div class="card-grid">
												for _, rb := range group.Runbooks {
													<a href={ templ.SafeURL("/" + rb.Slug) } class="runbook-card">
														<span class="card-title">{ rb.Title }</span>
														if rb.Description != "" {
															<span class="card-desc">@templ.Raw(markup.Prose(rb.Description))</span>
														}
													</a>
												}
											</div>
										</div>
									}
								</div>
							}
						</div>
					}
				</div>
			</div>
		</div>
	}
}

// commonSymptoms renders the symptom-first shortcuts inside the search hub: the
// first `symptoms:` phrase of each runbook that opts in with `common: true`.
templ commonSymptoms(issues []parser.CommonIssue) {
	if len(issues) > 0 {
		<div class="search-chips">
			<span class="search-chips-label">Common</span>
			for _, ci := range issues {
				<a class="search-chip" href={ templ.SafeURL("/" + ci.Slug) }>{ ci.Label }</a>
			}
		</div>
	}
}
