package views

import "runbooks/parser"

// Shell wraps the full HTML document. Children are rendered inside <body>.
templ Shell(title string) {
	<!DOCTYPE html>
	<html lang="en" data-theme="light">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ pageTitle(title) }</title>
			<link rel="icon" href="/public/favicon.svg" type="image/svg+xml"/>
			<link rel="stylesheet" href="/public/css/bundle.css"/>
			@templ.Raw("<script>" + themeScript + "</script>")
		</head>
		<body>
			{ children... }
			<div class="drawer-scrim" data-drawer-scrim></div>
			<script src="/public/js/vendor/jszip.min.js"></script>
			<script src="/public/js/vendor/marked.min.js"></script>
			<script src="/public/js/vendor/highlight.min.js"></script>
			<script src="/public/js/bundle.js"></script>
		</body>
	</html>
}

templ SidebarHeader() {
	<a class="sidebar-logo" href="/">
		<span class="wordmark"><span class="wordmark-run">run</span>books</span>
	</a>
	<button class="drawer-close sidebar-close" type="button" data-drawer-close aria-label="Close">✕</button>
}

// Rail is the thin left strip in the narrow layout: the brand mark and a menu
// button that opens the sidebar drawer. Hidden while the window is wide.
templ Rail() {
	<aside class="rail">
		<a class="rail-brand" href="/" aria-label="Runbooks">r</a>
		<button class="rail-btn" type="button" data-rail-menu aria-label="Menu" aria-expanded="false">☰</button>
	</aside>
}

templ SidebarNav(groups []parser.SystemGroup, active string) {
	for _, system := range groups {
		<p class="nav-system">{ system.Name }</p>
		for _, group := range system.Categories {
			if group.Name != "" {
				<p class="nav-section">{ group.Name }</p>
			}
			<nav>
				for _, rb := range group.Runbooks {
					<a href={ templ.SafeURL("/" + rb.Slug) } class={ navClass(active, rb.Slug) }>{ rb.Title }</a>
				}
			</nav>
		}
	}
}

// AppearanceControl is the sidebar footer: theme, code-weight and reading-size
// preferences. All are applied before first paint (see themeScript) and
// persisted client-side.
templ AppearanceControl() {
	<div class="appearance">
		<div>
			<p class="appearance-label">Theme</p>
			<div class="theme-row">
				<button class="theme-btn" data-theme="light" type="button">Light</button>
				<button class="theme-btn" data-theme="system" type="button">System</button>
				<button class="theme-btn" data-theme="dark" type="button">Dark</button>
			</div>
		</div>
		<div>
			<p class="appearance-label">Code weight</p>
			<div class="weight-row">
				<button class="weight-btn" data-weight="regular" type="button">Regular</button>
				<button class="weight-btn" data-weight="bold" type="button">Bold</button>
			</div>
		</div>
		<div>
			<p class="appearance-label">Text size</p>
			<div class="size-row">
				<button class="size-btn" data-size="small" type="button" title="Small">S</button>
				<button class="size-btn" data-size="medium" type="button" title="Medium">M</button>
				<button class="size-btn" data-size="large" type="button" title="Large">L</button>
			</div>
		</div>
		<div>
			<p class="appearance-label">Steps</p>
			<div class="steps-row">
				<button class="steps-btn" data-steps="first" type="button" title="Open the first step, collapse the rest">First open</button>
				<button class="steps-btn" data-steps="all" type="button" title="Open every step">All open</button>
			</div>
		</div>
	</div>
}

// SessionActions is the sidebar footer account section: the Admin page link
// (admins only) and Sign out (when identity is on).
templ SessionActions(isAdmin, identityEnabled bool) {
	if isAdmin || identityEnabled {
		<nav class="session-actions">
			if isAdmin {
				<a href="/admin">Admin</a>
			}
			if identityEnabled {
				<button type="button" data-auth="logout">Sign out</button>
			}
		</nav>
	}
}

// VarsPanel renders the sidebar variables section for a runbook page.
templ VarsPanel(fields []parser.VarField) {
	<div class="vars-panel">
		<p class="vars-heading">Variables</p>
		for _, f := range fields {
			<div class="var-field">
				<div class="var-label-row">
					<label class="var-label" for={ f.ID }>{ f.Label }</label>
					if f.Hint != "" {
						<button class="hint-btn" data-hint={ f.Hint } type="button" aria-label="How to find this value">?</button>
					}
				</div>
				if f.Secret {
					<input
						id={ f.ID }
						class="var-input"
						type="password"
						autocomplete="off"
						spellcheck="false"
						data-var={ f.VarName }
					/>
				} else {
					<input
						id={ f.ID }
						class="var-input"
						type="text"
						autocomplete="off"
						spellcheck="false"
						data-var={ f.VarName }
						placeholder={ f.Placeholder }
					/>
				}
			</div>
		}
	</div>
}

// CodeBlock renders a terminal-style code block with variable substitution and copy button.
// Labelled blocks are wrapped in a .code-group so the label + block can be ticked off together.
templ CodeBlock(label, tpl, lang string) {
	if label != "" {
		<div class="code-group">
			<div class="code-label-row">
				<span class="code-label-tick" aria-hidden="true">▸</span>
				<span class="code-label">{ label }</span>
				<button class="block-check" type="button" aria-label="Mark done">✓</button>
			</div>
			<div class="code-block" data-template={ tpl } data-lang={ lang }>
				<pre><code>{ toInitialDisplay(tpl) }</code></pre>
				<button class="copy-btn" type="button">Copy</button>
			</div>
		</div>
	} else {
		<div class="code-block" data-template={ tpl } data-lang={ lang }>
			<pre><code>{ toInitialDisplay(tpl) }</code></pre>
			<button class="copy-btn" type="button">Copy</button>
		</div>
	}
}

// Step renders a numbered step card. preview is shown in place of the body
// while the step is collapsed (the card's initial state is set client-side from
// the reading preference).
templ Step(n int, title, preview string) {
	<div class="step-card" id={ slugify(title) }>
		<div class="step-header">
			<span class="step-num">{ numStr(n) }</span>
			<h2 class="step-title">{ title }</h2>
			<button class="step-check" type="button" aria-label="Mark step done">✓</button>
			<button class="step-toggle" type="button" aria-expanded="true" aria-label="Toggle step">▾</button>
		</div>
		<div class="step-body">
			{ children... }
		</div>
		if preview != "" {
			<p class="step-preview">{ preview }</p>
		}
	</div>
}

// RollbackStep renders a step card in danger styling.
templ RollbackStep(title string) {
	<div class="step-card rollback-card" id={ slugify(title) }>
		<div class="step-header">
			<span class="step-num">↩</span>
			<h2 class="step-title">{ title }</h2>
		</div>
		<div class="step-body">
			{ children... }
		</div>
	</div>
}

// BranchBlock renders a [!branch] decision callout.
templ BranchBlock(body string) {
	<div class="notice notice-branch">
		@templ.Raw(branchHTML(body))
	</div>
}

templ Notice(variant, msg string) {
	<div class={ "notice " + noticeClass(variant) }>@templ.Raw(noticeHTML(msg))</div>
}

// Alert is interactive feedback. intent is danger|warn|info|success; weight is
// inline|panel|banner, where panel is the default and carries no modifier.
templ Alert(weight, intent, title, msg string) {
	<div class={ alertClass(weight, intent) } role="alert">
		<span class="alert-icon" aria-hidden="true">{ alertIcon(intent) }</span>
		<div class="alert-body">
			if title != "" {
				<p class="alert-title">{ title }</p>
			}
			<p class="alert-message">{ msg }</p>
		</div>
	</div>
}

// liveAlert is the client-populated panel alert. Rendered empty and hidden;
// app.js fills the title, message and detail and unhides it.
templ liveAlert() {
	<div class="alert alert-danger" role="alert" data-live-alert hidden>
		<span class="alert-icon" aria-hidden="true">⚠</span>
		<div class="alert-body">
			<p class="alert-title"></p>
			<p class="alert-message"></p>
			<p class="alert-detail" hidden></p>
		</div>
	</div>
}

templ ListBlock(items []string) {
	<ul class="prose-list">
		for _, item := range items {
			<li>@templ.Raw(proseHTML(item))</li>
		}
	</ul>
}

templ TableBlock(headers []string, rows [][]string) {
	<div class="table-wrap">
		<table>
			<thead>
				<tr>
					for _, h := range headers {
						<th>@templ.Raw(proseHTML(h))</th>
					}
				</tr>
			</thead>
			<tbody>
				for _, row := range rows {
					<tr>
						for _, cell := range row {
							<td>@templ.Raw(proseHTML(cell))</td>
						}
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ FrontmatterNotice(msg string) {
	<div class="runbook-notice">
		<span class="runbook-notice-icon" aria-hidden="true">⚠</span>
		<p>@templ.Raw(proseHTML(msg))</p>
	</div>
}

func numStr(n int) string {
	return itoa(n)
}

func noticeClass(v string) string {
	switch v {
	case "warn":
		return "notice-warn"
	case "danger":
		return "notice-danger"
	default:
		return ""
	}
}

func alertClass(weight, intent string) string {
	class := "alert"
	switch intent {
	case "warn":
		class += " alert-warn"
	case "info":
		class += " alert-info"
	case "success":
		class += " alert-success"
	default:
		class += " alert-danger"
	}
	switch weight {
	case "inline":
		class += " alert-inline"
	case "banner":
		class += " alert-banner"
	}
	return class
}

func alertIcon(intent string) string {
	switch intent {
	case "info":
		return "ⓘ"
	case "success":
		return "✓"
	default:
		return "⚠"
	}
}

func itoa(n int) string {
	if n < 0 {
		return "-" + itoa(-n)
	}
	if n < 10 {
		return string(rune('0' + n))
	}
	return itoa(n/10) + string(rune('0'+n%10))
}
